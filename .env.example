# Supabase (project name: cueline)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Video vendor (LiveKit Cloud project: cueline)
LIVEKIT_URL=wss://cueline.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Object storage for room-composite recordings (S3 or R2)
RECORDING_S3_BUCKET=
RECORDING_S3_ENDPOINT=
RECORDING_S3_REGION=auto
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET_KEY=
# Public base URL that serves the bucket (CDN in front of R2/S3); HLS playlists and recordings are read from here
RECORDING_PUBLIC_BASE_URL=https://media.cueline.app

# Stripe (account: cueline)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public origin of the web app (declared in the extension's externally_connectable)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chrome extension id (chrome://extensions after "Load unpacked" of apps/extension/dist); used for the auth handoff
NEXT_PUBLIC_EXTENSION_ID=

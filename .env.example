# Supabase (project name: cueline)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Video vendor (LiveKit Cloud project: cueline)
LIVEKIT_URL=wss://cueline.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Object storage for room-composite recordings (S3 or R2)
RECORDING_S3_BUCKET=
RECORDING_S3_ENDPOINT=
RECORDING_S3_REGION=auto
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET_KEY=
# Public base URL that serves the bucket (CDN in front of R2/S3); HLS playlists and recordings are read from here
RECORDING_PUBLIC_BASE_URL=https://media.cueline.app

# Stripe, both modes at once. Which one new payments use is a platform setting
# (app_settings.stripe_mode, switched by a platform admin on /host/billing); webhooks from
# both are accepted. Use restricted keys (rk_) where you can. See docs/STRIPE.md.
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_TEST=
STRIPE_SECRET_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_LIVE=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_LIVE=pk_live_51UUNhHPrQoeO5F661IxXzYZsJntyAs5nv2D2jPRMgFQDC9EiRzkYDP0Ihdo7T3AD1Ou8MwJHNVpw8dSRZSRaLFo500SNwiJeu9

# Public origin of the web app
NEXT_PUBLIC_APP_URL=http://localhost:3000


# Transactional email (Resend). Confirmation on registration and the reminder sequence before each event.
RESEND_API_KEY=
RESEND_FROM="Cueline <hello@example.com>"
# Vercel sets this header on cron requests to /api/emails/dispatch; any long random string.
CRON_SECRET=

# Cueline — deployment environment worksheet
#
# Fill in sections B and C, leave section D blank, and paste the result into your
# Claude Code environment's variables/secrets. Do NOT paste values into chat.
#
# Bulk-paste tip: if the settings UI takes a whole .env at once, comments are fine.
# If it takes one key/value row at a time, strip them first:
#   grep -v '^\s*#' docs/DEPLOY_ENV_TEMPLATE.env | grep -v '^\s*$'
#
# Mark each as a SECRET (not a plain variable) in the settings UI — every value
# below except the NEXT_PUBLIC_* ones and the two RECORDING_S3 non-key fields.


# =============================================================================
# A. BEFORE THIS WORKS AT ALL — network policy
# =============================================================================
# Variables alone are not enough: this environment's network policy currently
# returns 403 for every vendor API. Allow these hosts in the environment's
# network settings (or reconnect the Supabase + Vercel connectors instead):
#
#   api.supabase.com
#   <ref>.supabase.co
#   api.vercel.com
#   api.stripe.com
#   api.cloudflare.com                      (only if using R2)
#   <account>.r2.cloudflarestorage.com      (only if using R2)


# =============================================================================
# B. PROVISIONING CREDENTIALS — these are for me, not for the app
# =============================================================================
# They let me create and configure things on your behalf. They never go into
# Vercel, and you can delete them from the environment once setup is done.

# Supabase → Account → Access Tokens ("Personal access token", starts sbp_)
SUPABASE_ACCESS_TOKEN=
# The 20-char project ref from your project URL: supabase.com/dashboard/project/<ref>
SUPABASE_PROJECT_REF=
# Optional. Only needed for `supabase db push` / psql; without it I apply the
# migration through the Management API query endpoint instead.
SUPABASE_DB_PASSWORD=

# Vercel → Account Settings → Tokens
VERCEL_TOKEN=
# Optional. Only if the project lives under a team rather than your personal scope.
VERCEL_TEAM_ID=

# Optional, Cloudflare R2 only. Token needs "Workers R2 Storage: Edit".
# Lets me create the bucket and apply the CORS rule hls.js needs.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=


# =============================================================================
# C. APP RUNTIME — you must fill these; I have no way to obtain them
# =============================================================================

# --- LiveKit Cloud (project name: cueline) -----------------------------------
# Dashboard → Settings → Keys. No provisioning API exists, so this is manual.
LIVEKIT_URL=wss://
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Object storage for HLS segments + MP4 recordings (S3 or R2) -------------
RECORDING_S3_BUCKET=
# R2: https://<account_id>.r2.cloudflarestorage.com   |   plain AWS S3: leave blank
RECORDING_S3_ENDPOINT=
# R2: auto   |   AWS: the bucket's region, e.g. ap-southeast-2
RECORDING_S3_REGION=auto
# R2 access keys are created in the dashboard (R2 → Manage API tokens), not via API.
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET_KEY=
# Public CDN origin serving that bucket. Viewers fetch the HLS playlist from here,
# so it must be publicly readable and CORS-allow GET from your app origin.
RECORDING_PUBLIC_BASE_URL=https://

# --- Google OAuth (host sign-in) --------------------------------------------
# Google Cloud Console → Credentials → OAuth 2.0 Client ID (Web application).
# Authorized redirect URI: https://<SUPABASE_PROJECT_REF>.supabase.co/auth/v1/callback
# These go into Supabase's auth config, not into Vercel.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Stripe ------------------------------------------------------------------
# Start with test mode (sk_test_ / pk_test_) — I can verify the whole CTA flow
# end to end without touching live money.
STRIPE_SECRET_KEY=
# No API returns this one, so it has to be copied from the dashboard.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=


# =============================================================================
# D. LEAVE BLANK — I derive or create these during setup
# =============================================================================
# Fill one in only if you already know it, or if you'd rather not hand over the
# section B tokens; then I use what you provide instead.

# From SUPABASE_PROJECT_REF: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Fetched via Management API: GET /v1/projects/<ref>/api-keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Created when I register the /api/stripe/webhook endpoint; the signing secret
# comes back in that response.
STRIPE_WEBHOOK_SECRET=
# Your production origin. Known once the Vercel project exists, or set it now if
# you already have the domain (e.g. https://cueline.app). No trailing slash —
# the Google OAuth redirect is built from this value.
NEXT_PUBLIC_APP_URL=


# =============================================================================
# E. STILL MANUAL, WHATEVER YOU PUT ABOVE
# =============================================================================
# - Creating the Supabase / Vercel / LiveKit / Stripe / Cloudflare accounts,
#   and anything behind a card or a terms-of-service click.
# - Connecting Vercel to the GitHub repo (an OAuth consent in the dashboard).
#   Without it I deploy from the container with the Vercel CLI instead of
#   wiring up push-to-deploy.
# - Registering cueline.app and pointing DNS at Vercel + the media CDN.
# - Stripe live-mode activation.
# - Adding yourself to the seeded org after your first sign-in; the host page
#   prints the exact SQL with your user id.
